+  }
+  ESP_LOGE(TAG, "%s stream stopped after repeated USB transfer errors", LOG_STR_ARG(endpoint_name(event.endpoint)));
+  // A dead stream cannot be resumed; tear it down so the platform's next start() starts it afresh.
